# Rename to .env before running docker compose up
# cp .env.example .env
# Replace every CHANGE_ME below. The compose files refuse to start without
# POSTGRES_PASSWORD, and the API refuses to boot with the default SECRET_KEY
# when ENVIRONMENT is staging/production.

# ── arbiter-api (app/core/config.py) ────────────────────────────────
# development | test | local | staging | production
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://arbiter:CHANGE_ME@postgres:5432/arbiter
REDIS_URL=redis://redis:6379/0
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_MODE=jwt_api_keys
API_KEYS_ENABLED=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
STALE_PIPELINE_HOURS=24
API_V1_STR=/api/v1
PROJECT_NAME=Arbiter

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Create org, dev users and the demo pipeline on container start.
# Local quickstart only: docker-compose.prod.yml forces RUN_SEEDS=false.
RUN_SEEDS=true

# ── docker-compose PostgreSQL ───────────────────────────────────────
# Must match the password used inside DATABASE_URL above.
POSTGRES_PASSWORD=CHANGE_ME

# ── arbiter-dashboard (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://api:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ── seed_dev.py / seed_prod.py ──────────────────────────────────────
# Leave the passwords empty and seed_dev prints a random one once per user;
# seed_prod only creates missing users and never overwrites a changed password.
ARBITER_ADMIN_USER=admin@example.com
ARBITER_ADMIN_PASSWORD=
ARBITER_VIEWER_USER=viewer@example.com
ARBITER_VIEWER_PASSWORD=

# ── arbiter-collector (optional) ────────────────────────────────────
COLLECTOR_INTERVAL=30
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=
AIRFLOW_PASS=
ARBITER_API=http://api:8000
# Issue a key from the dashboard (API Keys) instead of reusing the seeded one.
ARBITER_KEY=
